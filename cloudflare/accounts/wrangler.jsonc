{
 "name":"perfect-view-accounts",
 "main":"worker.mjs",
 "compatibility_date":"2026-10-01",
 "observability":{"enabled":false},
 "vars":{
  "ALLOWED_ORIGINS":"https://perfectentry.store,https://www.perfectentry.store",
  "WHOP_CLIENT_ID":"REPLACE_WITH_APP_ID",
  "PERFECT_VIEW_PRODUCTS":"REPLACE_WITH_PRODUCT_ID",
  "SIGNALS_PRODUCTS":"REPLACE_WITH_PRODUCT_ID",
  "WHOP_SANDBOX":"false"
 },
 "d1_databases":[{"binding":"ACCOUNTS","database_name":"perfect-view-accounts","database_id":"REPLACE_AFTER_D1_CREATE","migrations_dir":"migrations"}],
 "triggers":{"crons":["17 * * * *"]}
}
