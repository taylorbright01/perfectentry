{
  "name": "perfect-view-collector",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "r2_buckets": [{ "binding": "CANDLES", "bucket_name": "perfect-view" }],
  "durable_objects": { "bindings": [{ "name": "COLLECTOR", "class_name": "PerfectViewCollector" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PerfectViewCollector"] }]
}
